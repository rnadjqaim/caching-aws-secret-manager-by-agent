{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSpecificSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:eu-central-1:73033537****:secret:secret-testingrenad-*"
      ]
    },
    {
      "Sid": "DecryptSecretKms",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "arn:aws:kms:eu-central-1:73033537****:key/YOUR_KMS_KEY_ID"
    }
  ]
}
